# Puerto del servidor (Railway lo define automáticamente)
PORT=3000

# Base de datos de la aplicación
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/miniblog

# Base de datos SOLO para tests: se vacía antes de cada test.
# Debe ser distinta de DATABASE_URL.
TEST_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/miniblog_test

# Usa true solo si tu proveedor exige una conexión SSL
DB_SSL=false
